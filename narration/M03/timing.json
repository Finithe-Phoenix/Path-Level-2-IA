  "audioSha256": "998264b49f79b485ac158030c8b019380acffe0b301c49e792512672975049f4",
  "captionsSha256": "554bd66fa87f71d0c4432813e1c44472228b32de560704fa53d4941855680f10",
  "scenes": [
    {
      "id": "reviewer",
      "scriptSha256": "54ade46ebfeb19bfffbda4af074c457a6bb1dba0404e43c7f9883c16063c1adf",
      "durationFrames": 610,
      "cues": [
        {
          "start": 0.259,
          "end": 1.727,
          "text": "This time you’re the reviewer."
        },
        {
          "start": 2.035,
          "end": 8.536,
          "text": "In the approved remote terminal, confirm\nthat GitHub CLI is using your own"
        },
        {
          "start": 8.536,
          "end": 12.373,
          "text": "authorized account and that you are in\nthe training repository."
        },
        {
          "start": 12.75,
          "end": 16.773,
          "text": "The author sends you pull request\nforty-two. Open that request for this"
        },
        {
          "start": 16.773,
          "end": 17.535,
          "text": "exercise."
        },
        {
          "start": 17.984,
          "end": 20.943,
          "text": "We’ll check the intent first, then the\nactual patch,"
        },
        {
          "start": 21.238,
          "end": 23.937,
          "text": "and finally the checks for the revision\nyou’re reviewing."
        }
      ]
    },
    {
      "id": "view",
      "scriptSha256": "a198108ad74d008c42ed8f155a27772b876c3d554bee3b0dae19e1c3431c08cc",
      "durationFrames": 581,
      "cues": [
        {
          "start": 0.3,
          "end": 5.369,
          "text": "Run the GitHub CLI view command for pull\nrequest forty-two."
        },
        {
          "start": 5.852,
          "end": 11.085,
          "text": "Read the title and the issue link. The\nauthor says zero should be rejected and"
        },
        {
          "start": 11.085,
          "end": 13.133,
          "text": "all four unit tests now pass."
        },
        {
          "start": 13.716,
          "end": 15.383,
          "text": "That tells you what to look for."
        },
        {
          "start": 15.69,
          "end": 19.818,
          "text": "Keep the issue open beside the terminal\nso you can compare the requested"
        },
        {
          "start": 19.818,
          "end": 22.74,
          "text": "behavior with the change you’re about to\ninspect."
        }
      ]
    },
    {
      "id": "diff",
      "scriptSha256": "f4274ba910821b1010a730e0390f209c899d622aa10027b1dfb68ffc76df679b",
      "durationFrames": 492,
      "cues": [
        {
          "start": 0.3,
          "end": 4.827,
          "text": "Now view the actual diff. The main\nchange removes equality at the boundary."
        },
        {
          "start": 5.134,
          "end": 9.076,
          "text": "The second change adds a test that calls\nthe validator with zero."
        },
        {
          "start": 9.502,
          "end": 12.689,
          "text": "Ask yourself whether that test would\nfail on the old code."
        },
        {
          "start": 13.18,
          "end": 17.84,
          "text": "This is the difference between seeing a\ntest name and seeing a test that proves"
        },
        {
          "start": 17.84,
          "end": 19.014,
          "text": "the relevant behavior."
        }
      ]
    },
    {
      "id": "checks",
      "scriptSha256": "d66f6dd777b6f381da4683adbe6244e3887152e6f8bc200e9aafda9d69fa3495",
      "durationFrames": 530,
      "cues": [
        {
          "start": 0.3,
          "end": 4.323,
          "text": "Look up the pull request’s required\nchecks. In the training example,"
        },
        {
          "start": 4.594,
          "end": 6.753,
          "text": "the unit test check is required."
        },
        {
          "start": 7.283,
          "end": 11.0,
          "text": "Open its run if you need to confirm\nwhich suite it executed."
        },
        {
          "start": 11.554,
          "end": 14.149,
          "text": "If the checks are pending, wait for the\nresult."
        },
        {
          "start": 14.752,
          "end": 19.366,
          "text": "If the author pushes again, refresh the\ndiff and checks for the new head before"
        },
        {
          "start": 19.366,
          "end": 20.672,
          "text": "making your decision."
        }
      ]
    },
    {
      "id": "request-changes",
      "scriptSha256": "55fd93eb96265ec6554bdca1ef1cb2aab751f3c0236c0bf93f944a9d7e1562db",
      "durationFrames": 570,
      "cues": [
        {
          "start": 0.259,
          "end": 3.139,
          "text": "Here’s the alternate outcome. The checks\nare green,"
        },
        {
          "start": 3.433,
          "end": 7.903,
          "text": "but the test added in this version\nexercises one and never calls the"
        },
        {
          "start": 7.903,
          "end": 9.216,
          "text": "validator with zero."
        },
        {
          "start": 9.758,
          "end": 14.688,
          "text": "That leaves the bug untested. Use the\nrequest-changes option and ask for the"
        },
        {
          "start": 14.688,
          "end": 15.579,
          "text": "missing assertion."
        },
        {
          "start": 16.103,
          "end": 21.487,
          "text": "Give the author a specific behavior to\nverify. Review the new revision after"
        },
        {
          "start": 21.487,
          "end": 22.273,
          "text": "they address it."
        }
      ]
    },
    {
      "id": "approve",
      "scriptSha256": "abfb5926a88f7b551c4f075a510951a8c1391dbdf501bc5352f8d478a23d913a",
      "durationFrames": 518,
      "cues": [
        {
          "start": 0.3,
          "end": 4.44,
          "text": "Return to the version with the right\ncondition and the actual zero test."
        },
        {
          "start": 4.912,
          "end": 7.516,
          "text": "If you’ve checked the diff and the\nrequired results,"
        },
        {
          "start": 8.023,
          "end": 11.238,
          "text": "you can approve with a short statement\nof what you verified."
        },
        {
          "start": 11.663,
          "end": 15.805,
          "text": "Submit the review from your account,\nthen read back the reviews on the pull"
        },
        {
          "start": 15.805,
          "end": 16.455,
          "text": "request.",
          "speechEnd": 16.329
        },
        {
          "start": 16.779,
          "end": 20.057,
          "text": "Confirm your decision was saved to the\nintended request."
        }
      ]
    },
    {
      "id": "exercise",
      "scriptSha256": "520c5703956439cbbce7d042bdddc04b7b1c6e67d6a55789b2157d8e72624b9b",
      "durationFrames": 574,
      "cues": [
        {
          "start": 0.259,
          "end": 5.1,
          "text": "Pair up and swap author and reviewer\nroles. Give each reviewer an issue,"
        },
        {
          "start": 5.325,
          "end": 7.671,
          "text": "a pull request, and the check results."
        },
        {
          "start": 8.119,
          "end": 11.625,
          "text": "In one run, the evidence is complete. In\nthe other,"
        },
        {
          "start": 11.828,
          "end": 13.941,
          "text": "leave out the test for the key input."
        },
        {
          "start": 14.613,
          "end": 17.989,
          "text": "Ask the reviewer to explain their\ndecision in one sentence."
        },
        {
          "start": 18.591,
          "end": 22.43,
          "text": "It should tell the author what was\nverified or what needs to change."
        }
      ]
    }
  ]
