  "paceBuild": "38c0508c20e8bd9478a3e1da580b929e3c70386dc2112315fa1a77dc0cdaf5d3",
  "delivery": {
    "targetWordsPerMinute": 149,
    "inputWordsPerMinute": 173.04,
    "tempo": 0.88203013,
    "outputWordsPerMinute": 148.99
  },
  "audioSha256": "950e0079fd2188ba7828610d26dfb8aac8fa1f2db616e61d7c3dcf1820081131",
  "captionsSha256": "c6f11953be1493fb5c9b35324dd1e9130f95fac17324eb6a0532af11bc5a662e",
  "scenes": [
    {
      "id": "intro",
      "scriptSha256": "c1456afb2b6c73caf4290aabdbc0d28757b6f654d047d148bbb84e3682bdfb3c",
      "durationFrames": 518,
      "cues": [
        {
          "start": 0.289,
          "end": 3.286,
          "text": "Here’s a small bug that makes a useful\nfull walkthrough."
        },
        {
          "start": 3.586,
          "end": 8.383,
          "text": "The order validator accepts zero. The\nissue says an order needs at least one"
        },
        {
          "start": 8.395,
          "end": 9.045,
          "text": "item.",
          "speechEnd": 8.724
        },
        {
          "start": 9.093,
          "end": 12.493,
          "text": "We’ll trace the cause in Copilot Plan,\nmake the change in Agent,"
        },
        {
          "start": 12.619,
          "end": 14.133,
          "text": "and show both test runs."
        },
        {
          "start": 14.612,
          "end": 17.035,
          "text": "Then we’ll hand the pull request to a\nteammate,"
        },
        {
          "start": 17.206,
          "end": 20.175,
          "text": "who reviews it with GitHub CLI."
        }
      ]
    },
    {
      "id": "issue",
      "scriptSha256": "3b2dd31e56bd3b8d5dd31ab60887761a9c356e905a1f782009b508a58cdb4943",
      "durationFrames": 521,
      "cues": [
        {
          "start": 0.312,
          "end": 3.824,
          "text": "Open the training issue. We want one and\nfive to pass,"
        },
        {
          "start": 4.131,
          "end": 6.44,
          "text": "and zero and negative one to fail."
        },
        {
          "start": 6.974,
          "end": 9.818,
          "text": "We also want to keep the existing\nfunction signature."
        },
        {
          "start": 10.189,
          "end": 14.944,
          "text": "Those details make the work easy to\ncheck. For your own training repository,"
        },
        {
          "start": 15.138,
          "end": 17.853,
          "text": "use the actual issue number GitHub\nassigned."
        },
        {
          "start": 18.262,
          "end": 20.508,
          "text": "Seventeen is the number in this example."
        }
      ]
    },
    {
      "id": "plan",
      "scriptSha256": "edca6c9c543d272a9b6a34fd4e8c07ba3b5ad7e9d6c6a7af6a415da844a76efd",
      "durationFrames": 542,
      "cues": [
        {
          "start": 0.289,
          "end": 4.469,
          "text": "In VS Code, open Copilot Chat and select\nPlan when it’s available."
        },
        {
          "start": 4.857,
          "end": 8.2,
          "text": "Add the issue, the validator, and the\nexisting tests."
        },
        {
          "start": 8.849,
          "end": 12.199,
          "text": "Ask why zero gets through and which test\nwould expose it."
        },
        {
          "start": 12.597,
          "end": 16.905,
          "text": "The plan should point to the equality in\nthe return line and propose a new zero"
        },
        {
          "start": 16.905,
          "end": 17.555,
          "text": "test.",
          "speechEnd": 17.308
        },
        {
          "start": 17.785,
          "end": 21.135,
          "text": "Read both files and agree on the scope\nbefore changing them."
        }
      ]
    },
    {
      "id": "regression",
      "scriptSha256": "4b606716902609d131df4cc75ba58b00eb61b5d52bcc2664fb5cb9bd5dcec279",
      "durationFrames": 596,
      "cues": [
        {
          "start": 0.334,
          "end": 5.176,
          "text": "Switch to Agent and ask for the test\nfirst. Inspect the edit and confirm the"
        },
        {
          "start": 5.176,
          "end": 7.292,
          "text": "source comparison has stayed the same."
        },
        {
          "start": 7.702,
          "end": 11.292,
          "text": "Run the approved test command on a\ncheckout with that edit."
        },
        {
          "start": 11.825,
          "end": 16.564,
          "text": "Find the line for the zero test. We\nexpected this failure because the old"
        },
        {
          "start": 16.564,
          "end": 19.056,
          "text": "implementation still returns true."
        },
        {
          "start": 19.544,
          "end": 23.356,
          "text": "If you see an import error instead, sort\nout the test setup first."
        }
      ]
    },
    {
      "id": "fix",
      "scriptSha256": "663d837eb7b6bce591e8bc54e2715872b8945ed2f1ee2f30ca5fec7f636feb59",
      "durationFrames": 575,
      "cues": [
        {
          "start": 0.289,
          "end": 3.421,
          "text": "Now make the one-line fix. When we\nremove equality,"
        },
        {
          "start": 3.569,
          "end": 5.881,
          "text": "zero no longer satisfies the condition."
        },
        {
          "start": 6.403,
          "end": 10.035,
          "text": "One and five still do, and negative one\nstill fails it."
        },
        {
          "start": 10.614,
          "end": 15.253,
          "text": "Run the same suite in the approved\nenvironment. The result should say four"
        },
        {
          "start": 15.253,
          "end": 16.773,
          "text": "tests ran and passed."
        },
        {
          "start": 17.307,
          "end": 21.68,
          "text": "Keep the red and green results together\nso your teammate can see what the new"
        },
        {
          "start": 21.68,
          "end": 22.504,
          "text": "test proved."
        }
      ]
    },
    {
      "id": "diff",
      "scriptSha256": "40bc58909c940e6ebf88793870c741f9ca954dd6ff475308e165d3b94e8b9760",
      "durationFrames": 565,
      "cues": [
        {
          "start": 0.334,
          "end": 5.28,
          "text": "Open Source Control in VS Code. Check\nthe validator diff for the comparison"
        },
        {
          "start": 5.28,
          "end": 9.384,
          "text": "change, then open the test diff and find\nthe zero assertion."
        },
        {
          "start": 9.918,
          "end": 12.138,
          "text": "Check that no unrelated file came along."
        },
        {
          "start": 12.627,
          "end": 17.089,
          "text": "Commit these two changes on the training\nfeature branch and publish the branch"
        },
        {
          "start": 17.089,
          "end": 18.413,
          "text": "through Source Control."
        },
        {
          "start": 18.732,
          "end": 22.2,
          "text": "You now have a small patch, with each\nchange tied to the issue."
        }
      ]
    },
    {
      "id": "pr",
      "scriptSha256": "f7d1ea904ea0cf57704e45ef46068588f5778a70335027137db9c054887b16e8",
      "durationFrames": 618,
      "cues": [
        {
          "start": 0.289,
          "end": 5.24,
          "text": "In the approved remote terminal, use an\nauthorized author account and a checkout"
        },
        {
          "start": 5.24,
          "end": 6.417,
          "text": "of the published branch."
        },
        {
          "start": 6.825,
          "end": 10.426,
          "text": "Prepare a short pull request body.\nInclude the change,"
        },
        {
          "start": 10.596,
          "end": 13.674,
          "text": "the red and green test evidence, and the\nissue link."
        },
        {
          "start": 14.322,
          "end": 20.602,
          "text": "Open the pull request with GitHub CLI.\nOur example receives number forty-two."
        },
        {
          "start": 21.029,
          "end": 24.328,
          "text": "Give that number to a separate\nauthorized teammate."
        }
      ]
    },
    {
      "id": "review",
      "scriptSha256": "01787cdb2123c8fa596b1c99931a633407859fe056505a3a9249b7c80073d54b",
      "durationFrames": 593,
      "cues": [
        {
          "start": 0.266,
          "end": 3.744,
          "text": "The reviewer uses their own account in\nthe approved terminal."
        },
        {
          "start": 4.062,
          "end": 8.776,
          "text": "Read the pull request, inspect the diff,\nand check the required results for that"
        },
        {
          "start": 8.776,
          "end": 9.426,
          "text": "revision.",
          "speechEnd": 9.373
        },
        {
          "start": 9.839,
          "end": 13.942,
          "text": "If the evidence supports approval, the\nhuman reviewer records it."
        },
        {
          "start": 14.453,
          "end": 17.403,
          "text": "If something is missing, they request a\nspecific change."
        },
        {
          "start": 17.841,
          "end": 22.375,
          "text": "This is the teammate’s decision. We’ll\npractice both outcomes in the dedicated"
        },
        {
          "start": 22.375,
          "end": 23.209,
          "text": "review lesson."
        }
      ]
    },
    {
      "id": "closure",
      "scriptSha256": "a270cb2726b5d153a77fa26c2f4df5b3c5022190f48116e055dc051be4901c1e",
      "durationFrames": 546,
      "cues": [
        {
          "start": 0.289,
          "end": 4.595,
          "text": "Look back at what you can hand over.\nThere’s an issue with clear inputs,"
        },
        {
          "start": 4.969,
          "end": 9.502,
          "text": "a small diff, a test that failed then\npassed, and a peer decision."
        },
        {
          "start": 10.059,
          "end": 12.915,
          "text": "Try the same workflow on another\nsynthetic issue."
        },
        {
          "start": 13.402,
          "end": 17.302,
          "text": "Replace the example identifiers with\nyour own training issue and pull"
        },
        {
          "start": 17.302,
          "end": 17.952,
          "text": "request.",
          "speechEnd": 17.832
        },
        {
          "start": 18.355,
          "end": 21.287,
          "text": "Ask your teammate to tell you which\nevidence they used."
        }
      ]
    }
  ]
}
