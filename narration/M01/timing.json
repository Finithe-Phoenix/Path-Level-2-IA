  "scenes": [
    {
      "id": "intro",
      "scriptSha256": "c1456afb2b6c73caf4290aabdbc0d28757b6f654d047d148bbb84e3682bdfb3c",
      "durationFrames": 538,
      "cues": [
        {
          "start": 0.443,
          "end": 3.763,
          "text": "Here’s a small bug that makes a useful\nfull walkthrough."
        },
        {
          "start": 3.816,
          "end": 6.306,
          "text": "The order validator accepts zero."
        },
        {
          "start": 6.36,
          "end": 8.887,
          "text": "The issue says an order needs at least\none item."
        },
        {
          "start": 9.542,
          "end": 13.531,
          "text": "We’ll trace the cause in Copilot Plan,\nmake the change in Agent,"
        },
        {
          "start": 13.681,
          "end": 15.876,
          "text": "and show both test runs."
        },
        {
          "start": 15.957,
          "end": 18.473,
          "text": "Then we’ll hand the pull request to a\nteammate,"
        },
        {
          "start": 18.527,
          "end": 20.892,
          "text": "who reviews it with GitHub CLI."
        }
      ]
    },
    {
      "id": "issue",
      "scriptSha256": "3b2dd31e56bd3b8d5dd31ab60887761a9c356e905a1f782009b508a58cdb4943",
      "durationFrames": 532,
      "cues": [
        {
          "start": 0.421,
          "end": 2.134,
          "text": "Open the training issue."
        },
        {
          "start": 2.188,
          "end": 6.337,
          "text": "We want one and five to pass, and zero\nand negative one to fail."
        },
        {
          "start": 6.391,
          "end": 9.161,
          "text": "We also want to keep the existing\nfunction signature."
        },
        {
          "start": 9.819,
          "end": 12.79,
          "text": "Those details make the work easy to\ncheck."
        },
        {
          "start": 12.844,
          "end": 17.348,
          "text": "For your own training repository, use\nthe actual issue number GitHub assigned."
        },
        {
          "start": 18.062,
          "end": 20.634,
          "text": "Seventeen is the number in this example."
        }
      ]
    },
    {
      "id": "plan",
      "scriptSha256": "edca6c9c543d272a9b6a34fd4e8c07ba3b5ad7e9d6c6a7af6a415da844a76efd",
      "durationFrames": 577,
      "cues": [
        {
          "start": 0.448,
          "end": 5.293,
          "text": "In VS Code, open Copilot Chat and select\nPlan when it’s available."
        },
        {
          "start": 5.374,
          "end": 8.501,
          "text": "Add the issue, the validator, and the\nexisting tests."
        },
        {
          "start": 9.195,
          "end": 13.238,
          "text": "Ask why zero gets through and which test\nwould expose it."
        },
        {
          "start": 13.291,
          "end": 17.628,
          "text": "The plan should point to the equality in\nthe return line and propose a new zero"
        },
        {
          "start": 17.682,
          "end": 18.183,
          "text": "test."
        },
        {
          "start": 18.863,
          "end": 22.213,
          "text": "Read both files and agree on the scope\nbefore changing them."
        }
      ]
    },
    {
      "id": "regression",
      "scriptSha256": "4b606716902609d131df4cc75ba58b00eb61b5d52bcc2664fb5cb9bd5dcec279",
      "durationFrames": 604,
      "cues": [
        {
          "start": 0.47,
          "end": 3.495,
          "text": "Switch to Agent and ask for the test\nfirst."
        },
        {
          "start": 3.576,
          "end": 8.073,
          "text": "Inspect the edit and confirm the source\ncomparison has stayed the same."
        },
        {
          "start": 8.153,
          "end": 11.354,
          "text": "Run the approved test command on a\ncheckout with that edit."
        },
        {
          "start": 12.038,
          "end": 14.314,
          "text": "Find the line for the zero test."
        },
        {
          "start": 14.368,
          "end": 19.186,
          "text": "We expected this failure because the old\nimplementation still returns true."
        },
        {
          "start": 19.267,
          "end": 23.356,
          "text": "If you see an import error instead, sort\nout the test setup first."
        }
      ]
    },
    {
      "id": "fix",
      "scriptSha256": "663d837eb7b6bce591e8bc54e2715872b8945ed2f1ee2f30ca5fec7f636feb59",
      "durationFrames": 578,
      "cues": [
        {
          "start": 0.474,
          "end": 2.723,
          "text": "Now make the one-line fix."
        },
        {
          "start": 2.777,
          "end": 7.087,
          "text": "When we remove equality, zero no longer\nsatisfies the condition."
        },
        {
          "start": 7.167,
          "end": 10.473,
          "text": "One and five still do, and negative one\nstill fails it."
        },
        {
          "start": 11.145,
          "end": 14.17,
          "text": "Run the same suite in the approved\nenvironment."
        },
        {
          "start": 14.224,
          "end": 17.517,
          "text": "The result should say four tests ran and\npassed."
        },
        {
          "start": 17.597,
          "end": 21.345,
          "text": "Keep the red and green results together\nso your teammate can see what the new"
        },
        {
          "start": 21.399,
          "end": 22.258,
          "text": "test proved."
        }
      ]
    },
    {
      "id": "diff",
      "scriptSha256": "40bc58909c940e6ebf88793870c741f9ca954dd6ff475308e165d3b94e8b9760",
      "durationFrames": 594,
      "cues": [
        {
          "start": 0.421,
          "end": 3.312,
          "text": "Open Source Control in VS Code."
        },
        {
          "start": 3.392,
          "end": 6.337,
          "text": "Check the validator diff for the\ncomparison change,"
        },
        {
          "start": 6.391,
          "end": 9.367,
          "text": "then open the test diff and find the\nzero assertion."
        },
        {
          "start": 10.022,
          "end": 13.074,
          "text": "Check that no unrelated file came along."
        },
        {
          "start": 13.154,
          "end": 17.438,
          "text": "Commit these two changes on the training\nfeature branch and publish the branch"
        },
        {
          "start": 17.491,
          "end": 18.603,
          "text": "through Source Control."
        },
        {
          "start": 19.304,
          "end": 22.928,
          "text": "You now have a small patch, with each\nchange tied to the issue."
        }
      ]
    },
    {
      "id": "pr",
      "scriptSha256": "f7d1ea904ea0cf57704e45ef46068588f5778a70335027137db9c054887b16e8",
      "durationFrames": 595,
      "cues": [
        {
          "start": 0.443,
          "end": 5.155,
          "text": "In the approved remote terminal, use an\nauthorized author account and a checkout"
        },
        {
          "start": 5.182,
          "end": 6.815,
          "text": "of the published branch."
        },
        {
          "start": 6.868,
          "end": 8.887,
          "text": "Prepare a short pull request body."
        },
        {
          "start": 9.542,
          "end": 13.89,
          "text": "Include the change, the red and green\ntest evidence, and the issue link."
        },
        {
          "start": 13.97,
          "end": 17.236,
          "text": "Open the pull request with GitHub CLI."
        },
        {
          "start": 17.29,
          "end": 19.512,
          "text": "Our example receives number forty-two."
        },
        {
          "start": 20.188,
          "end": 23.037,
          "text": "Give that number to a separate\nauthorized teammate."
        }
      ]
    },
    {
      "id": "review",
      "scriptSha256": "01787cdb2123c8fa596b1c99931a633407859fe056505a3a9249b7c80073d54b",
      "durationFrames": 609,
      "cues": [
        {
          "start": 0.421,
          "end": 4.169,
          "text": "The reviewer uses their own account in\nthe approved terminal."
        },
        {
          "start": 4.249,
          "end": 8.929,
          "text": "Read the pull request, inspect the diff,\nand check the required results for that"
        },
        {
          "start": 8.982,
          "end": 9.548,
          "text": "revision."
        },
        {
          "start": 10.216,
          "end": 14.312,
          "text": "If the evidence supports approval, the\nhuman reviewer records it."
        },
        {
          "start": 14.392,
          "end": 17.819,
          "text": "If something is missing, they request a\nspecific change."
        },
        {
          "start": 17.899,
          "end": 19.55,
          "text": "This is the teammate’s decision."
        },
        {
          "start": 20.215,
          "end": 23.568,
          "text": "We’ll practice both outcomes in the\ndedicated review lesson."
        }
      ]
    },
    {
      "id": "closure",
      "scriptSha256": "a270cb2726b5d153a77fa26c2f4df5b3c5022190f48116e055dc051be4901c1e",
      "durationFrames": 551,
      "cues": [
        {
          "start": 0.47,
          "end": 2.719,
          "text": "Look back at what you can hand over."
        },
        {
          "start": 2.772,
          "end": 5.712,
          "text": "There’s an issue with clear inputs, a\nsmall diff,"
        },
        {
          "start": 5.765,
          "end": 8.719,
          "text": "a test that failed then passed, and a\npeer decision."
        },
        {
          "start": 9.365,
          "end": 12.738,
          "text": "Try the same workflow on another\nsynthetic issue."
        },
        {
          "start": 12.818,
          "end": 16.673,
          "text": "Replace the example identifiers with\nyour own training issue and pull"
        },
        {
          "start": 16.727,
          "end": 17.396,
          "text": "request."
        },
        {
          "start": 18.098,
          "end": 21.058,
          "text": "Ask your teammate to tell you which\nevidence they used."
        }
      ]
    }
  ]
}
